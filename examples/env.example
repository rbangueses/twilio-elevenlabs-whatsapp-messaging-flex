# Server
PORT=3000
PUBLIC_BASE_URL=https://your-ngrok-domain.ngrok-free.app
NODE_ENV=development

# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace_with_twilio_auth_token
TWILIO_CONVERSATIONS_SERVICE_SID=ISxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_SENDER=whatsapp:+14155238886

# Flex / TaskRouter
FLEX_WORKSPACE_SID=WSxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FLEX_WORKFLOW_SID=WWxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FLEX_TASK_CHANNEL_UNIQUE_NAME=chat

# ElevenLabs
ELEVENLABS_API_KEY=replace_with_xi_api_key
ELEVENLABS_AGENT_ID=agent_xxxxxxxxxxxxxxxxxxxxxxxx
ELEVENLABS_WS_URL=wss://api.elevenlabs.io/v1/convai/conversation

# Shared secret for ElevenLabs -> relay webhook tool calls
HANDOFF_TOKEN=replace_with_long_random_token

# Local state
STATE_STORE=file
STATE_FILE=.data/conversation-state.json
